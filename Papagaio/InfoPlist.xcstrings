    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Texto de privacidade mostrado pelo macOS ao solicitar reconhecimento de fala.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ōmu uses speech recognition to show dictated notes while you speak. The final text is refined on your Mac and does not leave it."
