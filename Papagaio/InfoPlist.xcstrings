      "comment" : "Texto de privacidade mostrado pelo macOS ao solicitar acesso ao microfone.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ōmu records your microphone to transcribe what you say in a meeting."
